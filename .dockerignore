# ignore .git related folders
.git/
.github/
.gitignore
# ignore docs
docs/
# copy in licenses folder to the container
!docs/licenses/
# ignore logs
**/logs/
**/runs/
**/output/*
**/outputs/*
**/videos/*
**/wandb/*
*.tmp
# ignore docker
docker/cluster/exports/
docker/.container.cfg
# ignore recordings
recordings/
# ignore __pycache__
**/__pycache__/
**/*.egg-info/
# ignore local virtual environments
env_uwlab/
# Note: _isaaclab/ is NOT ignored so it gets synced to cluster
# ignore isaac sim symlink
_isaac_sim?
# Docker history
docker/.uw-lab-docker-history
# datasets
/datasets/

# Expert replay buffer datasets
expert_rb/

# Local training artifacts — uploaded explicitly to /mmfs1/.../<dir>/<file>
# when actually needed by a job, not bulk-synced with the source tree.
rbs/
checkpoints/
Datasets/
data_archive/
PegInsertive/
# Plot artifacts and stray .pt files dropped at the repo root
/critic_comparison.png
/ee_pose_over_time.png
/eval_initial_peg_xy.png
/peg_state_rl_expert_seed42.pt
/peg_state_rl_expert_seed42.pt.*
# Stray installers / large blobs that occasionally land at the repo root
/Miniconda3-latest-Linux-x86_64.sh
# Container image blobs anywhere in tree (docker/uw-lab-base.sif, docker/exports/*.tar, etc.)
**/*.sif
**/*.tar
**/*.deb
docker/exports/
# Root-level odds and ends
/env.bin
/Untitled

# Local training artifacts, same rationale as rbs/ above: these are outputs, not source, and
# bulk-syncing them pushes ~10 GB per submission onto a filesystem that sits above 90% full.
# Upload explicitly to /mmfs1/.../<dir>/<file> when a job actually needs one.
/checkpoints/
/data_archive/
/Datasets/
/PegInsertive/
/Miniconda3-latest-Linux-x86_64.sh
*.png
