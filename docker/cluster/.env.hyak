###
# Cluster specific settings — Hyak
#
# TODO: Fill in the placeholders marked <...> below before first use.
###

# Job scheduler used by cluster.
CLUSTER_JOB_SCHEDULER=SLURM

# Docker cache dir for Isaac Sim (has to end on docker-isaac-sim)
CLUSTER_ISAAC_SIM_CACHE_DIR=/mmfs1/gscratch/scrubbed/jtran/docker-isaac-sim

# UW Lab directory on the cluster (has to end on uwlab)
CLUSTER_UWLAB_DIR=/mmfs1/gscratch/scrubbed/jtran/uwlab

# Cluster login (SSH alias defined in ~/.ssh/config, or user@host)
CLUSTER_LOGIN=klone-login

# Cluster scratch directory to store the SIF file
CLUSTER_SIF_PATH=/mmfs1/gscratch/scrubbed/jtran

# Remove the temporary uwlab code copy after the job is done
REMOVE_CODE_COPY_AFTER_JOB=true

# Python executable within UW Lab directory to run with the submitted job
CLUSTER_PYTHON_EXECUTABLE=${CLUSTER_PYTHON_EXECUTABLE:-scripts/reinforcement_learning/holosoma/train.py}

# Cluster mount directory (Filesystem root to bind — Hyak uses mmfs1)
CLUSTER_MOUNT_DIR=/mmfs1

# Optional: cluster cloud assets dir (set if you want offline asset access)
# CLUSTER_CLOUD_ASSETS_DIR=/mmfs1/gscratch/scrubbed/jtran/cloud_assets

# Optional: local cloud assets source dir (used by `sync-assets` command)
# LOCAL_CLOUD_ASSETS_DIR=/path/to/local/cloud_assets

# rsl_rl: local path and remote destination (rsynced fresh on every job launch)
LOCAL_RSL_RL_DIR=/home/joshuat26/Documents/Github/rsl_rl
CLUSTER_RSL_RL_DIR=/mmfs1/gscratch/scrubbed/jtran/rsl_rl

# Holosoma: local path and remote destination (rsynced fresh on every job launch)
LOCAL_HOLOSOMA_DIR=/home/joshuat26/Documents/Github/holosoma
CLUSTER_HOLOSOMA_DIR=/mmfs1/gscratch/scrubbed/jtran/holosoma
# Persistent pip install dir for holosoma deps (populated on first run, cached after)
CLUSTER_HOLOSOMA_DEPS_DIR=/mmfs1/gscratch/scrubbed/jtran/holosoma-deps

# Weights & Biases API key
WANDB_API_KEY=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
