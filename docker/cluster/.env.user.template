###############################################################################
# UWLab Cluster User Configuration
#
# Copy this file to .env.user and fill in your values:
#   cp docker/cluster/.env.user.template docker/cluster/.env.user
#
# This is the ONLY file you need to edit for cluster setup.
###############################################################################

# --- User-editable variables (CHANGE THESE) ---

# Your UW NetID (same on both clusters)
CLUSTER_USER=<your-uw-netid>

# Your Hyak lab group / Slurm account (e.g., weirdlab, robotics)
HYAK_ACCOUNT=<your-lab-group>

# --- Hyak SLURM Defaults ---
# These can be overridden at runtime, e.g., PARTITION=ckpt ./cluster_interface.sh job ...
HYAK_PARTITION=gpu-a40                # Default: gpu-a40
HYAK_CPUS_PER_TASK=6                  # Default: 6
HYAK_MEM_PER_GPU=60G                  # Default: 60G
HYAK_CONSTRAINT="h200|l40|l40s|a40" # Default: "h200|l40|l40s|a40"
HYAK_TIME=24:00:00                    # Default: 24:00:00
HYAK_SLURM_LOGS_DIR=/gscratch/${HYAK_ACCOUNT}/${CLUSTER_USER}/slurm_logs

# --- Tillicum SLURM Defaults ---
TILLICUM_TIME=24:00:00                # Default: 24:00:00
TILLICUM_QOS=normal                   # Default: normal
TILLICUM_SLURM_LOGS_DIR=/gpfs/scrubbed/${CLUSTER_USER}/slurm_logs

# -----------------------------------------------

# --- Tillicum paths (derived from CLUSTER_USER) ---

# Use SSH config aliases to avoid password prompts (set up in ~/.ssh/config)
TILLICUM_LOGIN=tillicum
TILLICUM_DIR=/gpfs/scrubbed/${CLUSTER_USER}/uwlab
TILLICUM_CACHE_DIR=/gpfs/scrubbed/${CLUSTER_USER}/docker-isaac-sim
TILLICUM_SIF_PATH=/gpfs/scrubbed/${CLUSTER_USER}

# --- Hyak paths (derived from CLUSTER_USER and HYAK_ACCOUNT) ---

# Use SSH config aliases to avoid password prompts (set up in ~/.ssh/config)
HYAK_LOGIN=klone-login
HYAK_DIR=/gscratch/${HYAK_ACCOUNT}/${CLUSTER_USER}/uwlab
HYAK_CACHE_DIR=/gscratch/${HYAK_ACCOUNT}/${CLUSTER_USER}/docker-isaac-sim
HYAK_SIF_PATH=/gscratch/${HYAK_ACCOUNT}/${CLUSTER_USER}
