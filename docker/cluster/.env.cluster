###
# Cluster specific settings
###

# Job scheduler used by cluster.
# Currently supports PBS and SLURM
CLUSTER_JOB_SCHEDULER=SLURM
# Docker cache dir for Isaac Sim (has to end on docker-isaac-sim)
# e.g. /cluster/scratch/$USER/docker-isaac-sim
CLUSTER_ISAAC_SIM_CACHE_DIR=/gscratch/weirdlab/profjat/docker-isaac-sim
# UW Lab directory on the cluster (has to end on uwlab)
# e.g. /cluster/home/$USER/uwlab
CLUSTER_UWLAB_DIR=/gscratch/weirdlab/profjat/uwlab
# Cluster login
# Uses the `klone-login` alias from ~/.ssh/config (User profjat,
# HostName klone.hyak.uw.edu). The alias matters: it carries the
# ControlMaster/ControlPersist settings, so rsync and sbatch reuse an existing
# authenticated connection instead of re-prompting for Duo 2FA on every call.
CLUSTER_LOGIN=klone-login
# Cluster scratch directory to store the SIF file
# e.g. /cluster/scratch/$USER
CLUSTER_SIF_PATH=/gscratch/weirdlab/profjat/sif
# Remove the temporary uwlab code copy after the job is done
REMOVE_CODE_COPY_AFTER_JOB=false
# Python executable within UW Lab directory to run with the submitted job
CLUSTER_PYTHON_EXECUTABLE=scripts/reinforcement_learning/rsl_rl/train.py

###
# Hyak (klone) notes -- 2026-08-29
###
# Slurm accounts available to profjat:
#   ckpt-cse, ckpt-weirdlab, gpu-a100-cse, gpu-a40-weirdlab,
#   gpu-l40-weirdlab, gpu-l40s-cse, gpu-l40s-weirdlab
#
# Storage: /mmfs1/home/profjat is 7GB/10GB (70% full) -- too small for an Isaac
# Sim install, so everything lives under /gscratch/weirdlab. Note that share is
# itself at 16410GB/17408GB (94%) and 16.5M/17M inodes (97%), so a multi-GB
# container or conda env may not fit without cleanup first.
#
# NOT YET SATISFIED: this config assumes an Apptainer image at
# $CLUSTER_SIF_PATH. None exists yet, and `cluster_interface.sh` builds one via
#   apptainer build ... docker-daemon://uw-lab-$profile:latest
# which requires a working local Docker daemon. Docker on starfish is installed
# but not usable (daemon/permission), so that path is blocked from this machine.
# See ISAACLAB_3_MIGRATION.md for the options.
